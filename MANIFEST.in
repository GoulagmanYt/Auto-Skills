include install.ps1 install.sh codex-auto-bootstrap codex-auto-bootstrap.ps1 LICENSE README.md README.fr.md
include SECURITY.md CONTRIBUTING.md CHANGELOG.md CODE_OF_CONDUCT.md
recursive-include tests *.py
recursive-include tools *.py
prune docs
include docs/positioning.md docs/usage.md docs/compatibility.md docs/security-model.md docs/benchmark.md docs/release.md docs/public-alpha.md
recursive-include examples *.json *.toml *.py *.js *.mjs *.rs *.md
recursive-include benchmarks *.json *.md
global-exclude __pycache__ *.py[cod] .DS_Store
prune .serena
prune .codex
prune .agents
prune reports
